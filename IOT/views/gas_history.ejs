<%- include("partials/header") -%>

<table class="table table-striped table-bordered dataTable no-footer" style="width: 100%;">
    <thead>
      <tr>
        <th style="width: 50%;">Value</th>
        <th style="width: 50%;">Time</th>
      </tr>
    </thead>
    <tbody style="height:20px;">
      <% Gdata.forEach(function(temp) { %> 
        <tr style="height:20px;">
          <td style="height:20px;"><%= temp.value %></td>
          <td style="height:20px;"><%= new Date(temp.timestamp).toLocaleString() %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  
<%- include("partials/footer") -%>