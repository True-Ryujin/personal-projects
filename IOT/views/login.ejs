<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login Form</title>
  <link rel="stylesheet" href="/css/login.css">
</head>
<body>
  <div class="login-container">
    <h2 class="login-title">Login Form</h2>
    <form class="login-form" action="/login" method="post">
      <input type="text" placeholder="Username or E-mail" class="login-input" name="email">
      <input type="password" placeholder="Password" class="login-input" name="password">
      <div class="form-actions">
        <button type="submit" class="btn" href="index">Log in</button>
      </div>
      <div class="create-account">
        <a href="signup">New to site? Create Account</a>
      </div>
    </form>
  </div>
</body>
</html>

